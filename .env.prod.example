# =============================================================================
# Klara Home - production environment (VPS)
# =============================================================================
# Copy to `.env.prod` ON THE SERVER and fill it in. `.env.prod` is git-ignored and must NEVER
# be committed; it holds every secret the stack has.
#
#   cp .env.prod.example .env.prod
#   chown root:root .env.prod && chmod 600 .env.prod
#
# It is read by docker compose, and only by docker compose:
#
#   docker compose -f infra/compose/docker-compose.prod.yml --env-file .env.prod up -d
#
# Full walkthrough: docs/deployment-vps.md. Values marked REQUIRED have no default - compose
# refuses to start and names the missing variable rather than booting something half-configured.
# =============================================================================


# -----------------------------------------------------------------------------
# 1. IDENTITY OF THIS DEPLOYMENT
# -----------------------------------------------------------------------------

# Prefixes container, network and volume names. Change it (to `klarahome-staging`, say) to run a
# second isolated stack on the same box - it gets its own volumes, so its own database.
COMPOSE_PROJECT_NAME=klarahome

# REQUIRED. The registrable domain. Every hostname is derived from it:
#   <domain> and www.<domain>  storefront      admin.<domain>  back office
#   api.<domain>               API             cdn.<domain>    imgproxy
#   s3.<domain>                object storage
# They must share this one registrable domain: the refresh cookie is SameSite=Lax, and a browser
# will not send it from a shop on one site to an API on another.
DOMAIN=klarahome.example

# Where images are pulled from, and which build. Deploy a specific immutable tag - a commit SHA
# or a release version - never `latest`, or a rollback has nothing to roll back to.
REGISTRY=ghcr.io/your-org
IMAGE_TAG=


# -----------------------------------------------------------------------------
# 2. DATABASE
# -----------------------------------------------------------------------------
# Two things are configured here and they are deliberately separate:
#
#   POSTGRES_*                   initialise and run the postgres CONTAINER in this stack
#   DATABASE_CONNECTION_STRING   tell the application WHERE ITS DATABASE IS
#
# While the database is in Docker they describe the same server, so the user, password and
# database name have to agree. When the database moves to Neon or another managed provider, only
# the connection string changes - see docs/deployment-vps.md section 9.

# REQUIRED. Used only when the postgres container first initialises its volume; changing them
# afterwards does NOT change the credentials inside an existing volume.
POSTGRES_DB=klarahome
POSTGRES_USER=klarahome
POSTGRES_PASSWORD=

# REQUIRED. The one place the application's database address is set - API, worker and migrator
# all read this. `Include Error Detail` is deliberately absent: it puts parameter values into
# error messages.
DATABASE_CONNECTION_STRING=Host=postgres;Port=5432;Database=klarahome;Username=klarahome;Password=CHANGE_ME;Maximum Pool Size=40;Timeout=15;Command Timeout=30

# Whether the migrator runs the seeders after migrating. They are idempotent and re-runnable, so
# leave this on; set false only for a restore drill that must bring a schema up to date without
# touching data.
DATABASE_RUN_SEEDERS=true

# Tuning for the container. Defaults suit an 8 GB box (docs/06-infrastructure-devops.md section 2);
# on a 4 GB box use shared_buffers=1GB and effective_cache_size=2GB.
POSTGRES_MAX_CONNECTIONS=200
POSTGRES_SHARED_BUFFERS=2GB
POSTGRES_EFFECTIVE_CACHE_SIZE=4GB
POSTGRES_MAINTENANCE_WORK_MEM=256MB
POSTGRES_LOG_MIN_DURATION_MS=500
POSTGRES_CPU_LIMIT=2.00
POSTGRES_MEMORY_LIMIT=3G


# -----------------------------------------------------------------------------
# 3. REDIS AND OBJECT STORAGE
# -----------------------------------------------------------------------------

# REQUIRED. Cache, sessions, rate-limit counters and idempotency keys. Nothing here is the system
# of record: losing this volume costs a cold cache and nothing else.
REDIS_PASSWORD=
REDIS_MAXMEMORY=512mb

# REQUIRED. MinIO's root credentials, which are also the S3 access key pair the API signs with.
# Treat MINIO_ROOT_PASSWORD as a secret of the same weight as the database password.
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
STORAGE_PUBLIC_BUCKET=media-public
STORAGE_PRIVATE_BUCKET=docs-private

# REQUIRED. What stops cdn.<domain> being a free image proxy for anyone who finds it. Generate
# both as 64 hex characters:
#   openssl rand -hex 32
IMGPROXY_KEY=
IMGPROXY_SALT=


# -----------------------------------------------------------------------------
# 4. LOOPBACK PORTS
# -----------------------------------------------------------------------------
# Where each container is published on 127.0.0.1, and therefore what Caddy proxies to
# (infra/caddy/Caddyfile). Change one only if something else on the VPS already holds the port -
# and change the Caddyfile to match.
API_PORT=8080
ADMIN_PORT=8081
STOREFRONT_PORT=4000
IMGPROXY_PORT=8082
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

API_CPU_LIMIT=2.00
API_MEMORY_LIMIT=2G
WORKER_CPU_LIMIT=1.00
WORKER_MEMORY_LIMIT=1G
STOREFRONT_CPU_LIMIT=1.50
STOREFRONT_MEMORY_LIMIT=1G


# -----------------------------------------------------------------------------
# 5. TENANT AND BRANDING
# -----------------------------------------------------------------------------
# The white-label identity the migrator seeds into the tenant row and the store settings. Set
# these BEFORE the first migrator run; afterwards the store's name is edited in the back office,
# not here.
TENANT_CODE=klarahome
TENANT_NAME=Klara Home
TENANT_DEFAULT_LOCALE=en-IN
TENANT_DEFAULT_TIMEZONE=Asia/Kolkata

# Pin the tenant id only when restoring into a rebuilt environment that must keep the old one.
TENANT_ID=


# -----------------------------------------------------------------------------
# 6. KEYS AND THE FIRST ADMINISTRATOR
# -----------------------------------------------------------------------------
# Generate these once, store them in a password manager, and back them up separately from the
# database. Losing AUTH_SIGNING_KEY_PEM signs everybody out; losing ENCRYPTION_KEY makes every
# seller's bank account number unreadable, permanently.

# REQUIRED. The RSA private key access tokens are signed with. Any label; changing it invalidates
# nothing on its own, and it identifies the key in a token header.
AUTH_SIGNING_KEY_ID=prod-2026-01
# REQUIRED. One line, with \n escapes, inside double quotes. Produce it from a PEM file with:
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out signing.pem
#   printf 'AUTH_SIGNING_KEY_PEM="%s"\n' "$(awk 'BEGIN{ORS="\\n"}1' signing.pem)"
AUTH_SIGNING_KEY_PEM=""

# REQUIRED. 32 bytes, base64, for the credentials the identity module encrypts (authenticator
# secrets, external provider tokens):
#   openssl rand -base64 32
AUTH_ENCRYPTION_KEY=

# REQUIRED, and DIFFERENT from the one above: this one protects business data a seller gave you -
# bank account numbers - rather than credentials.
#   openssl rand -base64 32
ENCRYPTION_KEY=

# The first platform administrator, created by a seeder that does nothing at all once any
# administrator exists. Fill both in for the first migrator run, sign in, enrol an authenticator,
# then blank them again and redeploy.
AUTH_BOOTSTRAP_EMAIL=
AUTH_BOOTSTRAP_PASSWORD=

# External identity providers. A provider with no client id is left off the sign-in page rather
# than offered and broken. The redirect URI to register with them is
# https://api.<domain>/api/v1/store/auth/external/<provider>/callback
AUTH_GOOGLE_ENABLED=false
AUTH_GOOGLE_CLIENT_ID=
AUTH_GOOGLE_CLIENT_SECRET=
AUTH_FACEBOOK_ENABLED=false
AUTH_FACEBOOK_CLIENT_ID=
AUTH_FACEBOOK_CLIENT_SECRET=


# -----------------------------------------------------------------------------
# 7. REFERENCE DATA
# -----------------------------------------------------------------------------
# The India Post PIN code CSV, if you have placed one at infra/seed/pincodes.csv on the server
# (format: infra/seed/README.md). Blank skips the import, and the platform.pincode-lookup feature
# flag should then stay off.
PINCODE_DATA_PATH=


# -----------------------------------------------------------------------------
# 8. EMAIL AND SMS
# -----------------------------------------------------------------------------
# There is no Mailpit in production. With no SMTP host the notification dispatcher records each
# message as suppressed and names the reason - the store works, nobody is emailed.
EMAIL_PROVIDER=smtp
EMAIL_FROM_ADDRESS=no-reply@klarahome.example
EMAIL_FROM_NAME=Klara Home
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USERNAME=
EMAIL_SMTP_PASSWORD=
# Never false outside development.
EMAIL_SMTP_USE_TLS=true

# Indian SMS needs DLT registration; until then leave the provider blank.
SMS_PROVIDER=
SMS_API_KEY=
SMS_SENDER_ID=
SMS_DLT_ENTITY_ID=


# -----------------------------------------------------------------------------
# 9. PAYMENTS, SHIPPING, PAYOUTS, SEARCH
# -----------------------------------------------------------------------------
# Every one of these is blank-safe: with no credentials the adapter reports itself unusable and
# the affected placement answers 503 naming the reason, while everything around it keeps working.
# Fill them in as each account is opened.

# Razorpay. The key id is publishable by design - it initialises the browser widget. The other
# three never leave the server. Webhook URL to register:
#   https://api.<domain>/api/v1/webhooks/razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_ACCOUNT_NUMBER=
RAZORPAY_ROUTE_ENABLED=false
RAZORPAY_BASE_URL=https://api.razorpay.com/v1/
PAYMENTS_PROVIDER=razorpay
PAYMENTS_RETRY_WINDOW_HOURS=24
PAYMENTS_AUTO_REFUND_ON_CANCELLATION=true

# Shipping. `shiprocket` names the adapter; blank falls back to parcels booked by hand from an
# air waybill an operator types in. Webhook URL to register:
#   https://api.<domain>/api/v1/webhooks/shipping/shiprocket
SHIPPING_PROVIDER=
SHIPPING_BASE_URL=
SHIPPING_API_KEY=
SHIPPING_API_USER=
SHIPPING_API_SECRET=
SHIPPING_WEBHOOK_SECRET=

# Vendor payouts. With no rail named, periods still close and batches are still built and
# approved - only the transfer refuses.
PAYOUTS_PROVIDER=
PAYOUTS_MODE=IMPS
PAYOUTS_NARRATION=Marketplace payout

# Search. PostgreSQL full text needs nothing configured, so blank is the working state rather
# than a degraded one (ADR-019).
SEARCH_PROVIDER=
SEARCH_BASE_URL=
SEARCH_API_KEY=


# -----------------------------------------------------------------------------
# 10. OBSERVABILITY AND MISCELLANEOUS
# -----------------------------------------------------------------------------

# An OTLP collector, when Step 31 stands one up. Blank disables export; logs still go to stdout
# as JSON and are collected by the Docker log driver.
OBSERVABILITY_OTLP_ENDPOINT=

# There is no virus scanner in this stack yet; turning this on would refuse every upload.
MEDIA_REQUIRE_VIRUS_SCAN=false

KH_ANALYTICS_PROVIDER=
KH_ANALYTICS_MEASUREMENT_ID=
