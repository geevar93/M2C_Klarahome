# =============================================================================
# Klara Home - environment variables
# =============================================================================
# Copy to `.env` and edit. `.env` is git-ignored and must NEVER be committed.
#
#   cp .env.example .env
#
# Two groups live here:
#   1. LOCAL DEV STACK  - consumed by infra/compose/docker-compose.dev.yml today.
#                         Every one of these has a working default baked into the
#                         compose file, so the stack starts even with no .env.
#   2. APPLICATION      - the variable names the API/worker bind from
#                         (docs/06-infrastructure-devops.md #4.1).
#                         The api container gets the ones it needs today directly
#                         from the compose file, derived from the values in
#                         group 1; the rest are documented for the steps that
#                         introduce them.
#
# Production secrets are NOT delivered this way: they are Docker secrets or a
# SOPS-encrypted file, mounted by path via the `*__File` convention.
# =============================================================================


# -----------------------------------------------------------------------------
# 1. LOCAL DEV STACK
# -----------------------------------------------------------------------------

# --- Compose ---
# Prefixes container, network and volume names. Change it to run two isolated
# stacks side by side (e.g. klarahome-dev and klarahome-scratch).
COMPOSE_PROJECT_NAME=klarahome-dev

# Host interface the published ports bind to. 127.0.0.1 keeps every service off
# the LAN. Set to 0.0.0.0 only to test from a phone on the same network.
BIND_ADDRESS=127.0.0.1

# Base hostname for the edge. Browsers resolve *.localhost to the loopback address without any
# hosts-file entry.
DEV_DOMAIN=klarahome.localhost

# Which reverse proxy fronts the local stack (infra/scripts/dev.ps1 and dev.sh read this):
#   caddy    plain http on port 80, the production topology (infra/compose/docker-compose.local.yml
#            over the dev file, infra/caddy/Caddyfile.local). Nothing to trust, nothing to click
#            through: every app, XHR and image just works. The default.
#   traefik  the original https edge with a self-signed certificate. Chrome refuses every XHR and
#            <img> from a subdomain it has not been told to trust, with no interstitial - see
#            docs/dev-setup.md section 5 before choosing this.
DEV_EDGE=caddy

# --- Traefik ---
HTTP_PORT=80
HTTPS_PORT=443

# --- PostgreSQL 18 ---
POSTGRES_DB=klarahome
POSTGRES_USER=klarahome
POSTGRES_PASSWORD=klarahome_dev_password
# Change if a native PostgreSQL already owns 5432 (common on Windows).
POSTGRES_PORT=5432

# --- Redis 8 ---
REDIS_PASSWORD=klarahome_dev_password
REDIS_PORT=6379

# --- MinIO (S3-compatible object storage) ---
MINIO_ROOT_USER=klarahome
MINIO_ROOT_PASSWORD=klarahome_dev_password
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
# Buckets created by the minio-init one-shot (docs/08-integrations.md #4).
STORAGE_PUBLIC_BUCKET=media-public
STORAGE_PRIVATE_BUCKET=docs-private

# --- Mailpit (captures all outbound email in dev) ---
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# --- imgproxy (Step 8: on-the-fly image renditions) ---
# Hex-encoded, and they must match Media__Imgproxy__Key / __Salt below - the API signs the URL
# and imgproxy verifies it. Blank in development means unsigned URLs, which imgproxy allows.
#
# SET BOTH IN ANY DEPLOYED ENVIRONMENT. Unsigned, imgproxy will resize any image in the allowed
# source bucket for anybody who finds the host, with the bandwidth billed to this deployment and
# served from this domain. Generate with:
#   openssl rand -hex 32
IMGPROXY_KEY=
IMGPROXY_SALT=

# --- API container (Step 3) ---
# Reachable only through Traefik at https://api.${DEV_DOMAIN}. It publishes no
# host port of its own.
#   up:      ./infra/scripts/dev.ps1 up
#   rebuild: docker compose -f infra/compose/docker-compose.dev.yml --env-file .env up -d --build api
API_IMAGE_TAG=dev
API_BUILD_CONFIGURATION=Release
# Debug|Development|Staging|Production. Development turns on the Scalar API
# reference and the diagnostics endpoints.
ASPNETCORE_ENVIRONMENT=Development
# Containers log JSON so a shipper can read them; set false to get the
# human-readable console template in `docker logs`.
OBSERVABILITY_CONSOLE_JSON=true
# Empty in dev: telemetry is collected but not exported until the collector
# arrives with Step 31.
OBSERVABILITY_OTLP_ENDPOINT=
# White-label identity of this deployment (ADR-006). Stamped on every log line, seeded into
# platform.tenants, and used as the initial store name in the branding settings.
TENANT_CODE=klarahome
TENANT_NAME=Klara Home
TENANT_DEFAULT_LOCALE=en-IN
TENANT_DEFAULT_TIMEZONE=Asia/Kolkata
# The tenant id written into tenant_id on every row. Blank in dev: it is derived from
# TENANT_CODE, which survives a restart but not a change of code. Set it explicitly on any
# deployment that holds data.
TENANT_ID=
# Path inside the container to the India Post PIN code CSV. infra/seed is mounted at /app/seed,
# so dropping pincodes.csv there and re-running the migrator imports it. Blank: import skipped.
PINCODE_DATA_PATH=


# -----------------------------------------------------------------------------
# 2. APPLICATION (documented now, consumed from Step 3 onwards)
# -----------------------------------------------------------------------------

# --- Host ---
# ASPNETCORE_ENVIRONMENT is set in group 1, where the container reads it.
# Set per container by compose: api | worker | migrator
APP_ROLE=api

# --- Data ---
# Host names below are the compose service names, resolved on the data network.
# The api container receives these already composed from the group 1 values;
# they are repeated here as the documented contract for staging and production.
ConnectionStrings__Postgres=Host=postgres;Port=5432;Database=klarahome;Username=klarahome;Password=klarahome_dev_password
ConnectionStrings__Redis=redis:6379,password=klarahome_dev_password

# --- Object storage (S3 API - MinIO in dev, S3/R2 in production) ---
Storage__Endpoint=http://minio:9000
Storage__AccessKey=klarahome
Storage__SecretKey=klarahome_dev_password
Storage__Bucket=media-public
Storage__PrivateBucket=docs-private
Storage__Region=ap-south-1
Storage__ForcePathStyle=true
Storage__PublicBaseUrl=https://s3.klarahome.localhost/media-public
# The address a *signed* URL is issued against, when it differs from Storage__Endpoint. SigV4
# covers the host, so a URL signed for the internal address is unreachable from a browser and
# cannot be rewritten to a reachable one. Leave empty for AWS S3 or R2, where the two are the same.
Storage__SignedUrlEndpoint=https://s3.klarahome.localhost
# How long a signed URL to a private document stays valid. Short on purpose: the URL carries no
# authorisation of its own beyond its expiry, so anyone it is forwarded to can read the document
# until it lapses.
Storage__SignedUrlMinutes=10

# --- Media (Step 8) ---
# Limits are an operational property of the deployment - how much disk and bandwidth it has -
# rather than something a shopkeeper decides, which is why they are here and not in store settings.
Media__MaxImageBytes=10485760
Media__MaxDocumentBytes=26214400
# A cap on pixels as well as bytes. A 40000x40000 PNG of one flat colour compresses to a few
# hundred kilobytes and costs gigabytes to decode; the derivative service is what would decode it.
Media__MaxImageDimension=8000
# Off, because v1 ships with the no-op scanner and a deployment that refused every upload would be
# useless. Set it true and uploads are refused while no real scanner is registered - which is the
# state a deployment handling KYC documents should be in.
Media__RequireVirusScan=false
# Browser-facing imgproxy address, and the address imgproxy itself fetches originals from. The
# second is internal: a browser cannot and should not reach it.
Media__Imgproxy__BaseUrl=https://img.klarahome.localhost
Media__Imgproxy__SourceBaseUrl=http://minio:9000/media-public
Media__Imgproxy__Key=
Media__Imgproxy__Salt=
Media__Imgproxy__Format=webp

# --- Generated documents (Step 8, ADR-015) ---
# PDFsharp embeds the glyphs it draws, so it needs a real font file, and the chiselled runtime
# image has none. The image copies DejaVu into /app/fonts at build time; this only needs setting
# for a deployment that keeps fonts somewhere else.
# Documents__FontDirectories__0=/app/fonts

# --- Authentication ---
# Development value only. Production uses a rotated secret from Docker secrets.
Jwt__Issuer=https://api.klarahome.localhost
Jwt__Audience=klarahome
Jwt__SigningKey=CHANGE_ME_dev_only_at_least_32_characters_long
Jwt__AccessTokenMinutes=15
Jwt__RefreshTokenDays=30

# --- Payments: Razorpay (Step 15 - sandbox credentials not yet provisioned) ---
Razorpay__KeyId=
Razorpay__KeySecret=
Razorpay__WebhookSecret=
Razorpay__AccountNumber=
Razorpay__RouteEnabled=false

# --- Vendor payouts (Step 18 - no payout account provisioned) ---
# Blank is the shippable state, exactly as it is for the gateway and the courier. With no rail
# named, sales still earn, deductions still come off, settlement periods still close and payout
# batches are still built and approved - the transfer refuses with a named
# 503 PAYOUT_PROVIDER_UNAVAILABLE and the ledger goes on saying to the paisa what every seller is
# owed. Nothing pretends money moved.
#
# Payouts__Provider names the RAIL, and is the only place one is named:
#   route  Razorpay Route: a transfer to the seller's linked account at the gateway. The
#          recommended arrangement (docs/08-integrations.md section 1). Also needs
#          Razorpay__RouteEnabled=true and a linked account per seller.
#   x      RazorpayX: a direct bank payout out of a funded balance. Needs
#          Razorpay__AccountNumber, which is the merchant's own account the money is drawn from.
#   <blank>  no rail at all. What an unrecognised value falls back to.
Payouts__Provider=
Payouts__Mode=IMPS
Payouts__Narration=Marketplace payout

# --- Shipping / logistics (Step 16, Shiprocket at Step 16A - not yet provisioned) ---
# Blank is the shippable state. With no courier account the manual adapter books parcels from an
# air waybill an operator types in, and everything downstream is unchanged. See SHIPPING_* below.
#
# Shipping__Provider names the ADAPTER, and is the only place a courier is named:
#   shiprocket  the v1 courier (ADR-018). Needs BaseUrl + ApiUser + ApiSecret.
#   manual      hand-booking. What a blank or unrecognised value falls back to.
Shipping__Provider=
Shipping__ApiKey=
Shipping__ApiUser=
Shipping__ApiSecret=
Shipping__WebhookSecret=
Shipping__BaseUrl=

# --- Search (Step 19) ---
# Blank is the shippable state and, unlike the gateway, the courier and the payout rail, it is not a
# degraded one: PostgreSQL full text needs no credentials, no second container and no network hop,
# so search works in every deployment on the day it is installed (ADR-007, ADR-019).
#
# Search__Provider names the ENGINE, and is the only place one is named:
#   <blank>  PostgreSQL full text. Also what an unrecognised value falls back to.
#   postgres the same thing, said explicitly.
#   <other>  a dedicated engine, which also needs BaseUrl + ApiKey AND the
#            search.external-engine feature flag switched on. Naming one whose credentials are
#            blank falls back to PostgreSQL and says so in the log rather than serving a store
#            with no search at all.
Search__Provider=
Search__BaseUrl=
Search__ApiKey=
Search__IndexName=products
# The staleness sweep runs in the WORKER and nowhere else, exactly as every sweeper before it. It is
# the safety net under the event pipeline, not how the index is kept current - on a healthy
# deployment it finds nothing every fifteen minutes for ever, and that is what it is for.
Search__ReindexEnabled=false
Search__ReindexIntervalMinutes=15
Search__ReindexBatchSize=200
Search__StaleAfterHours=24

# --- Reviews, Q&A, wishlist & stock alerts (Step 21) ---
# Moderation is ON by default, which is what the three AutoApprove switches being false means. That
# is a decision about legal exposure rather than about merchandising: in India an intermediary that
# publishes user content unreviewed sits differently under the IT Rules than one that moderates
# (docs/07-security-compliance.md section 5), and it is deliberately NOT a store setting a
# merchandiser can flip from an admin screen at four on a Friday.
Reviews__AutoApproveReviews=false
Reviews__AutoApproveQuestions=false
Reviews__AutoApproveAnswers=false
# The one exception, and it is defensible: a seller answering a question about their own product is
# an identified party under a contract with the store. Holding their answers in a queue makes Q&A
# useless - its whole value is somebody who knows replying while the shopper is still on the page.
Reviews__AutoApproveVendorAnswers=true
# How long after DELIVERY a review may still be written. Measured from delivery rather than from the
# order, so a parcel that took three weeks gives its recipient the same window as one that did not.
Reviews__ReviewWindowDays=365
# How long a back-in-stock or price-drop alert is watched before the interest is assumed gone. An
# alert on something out of stock for three months is one the shopper has forgotten asking for.
Reviews__SubscriptionExpiryDays=90
# The ceiling on one restock fanning out. The sweep takes whatever a single event did not.
Reviews__MaxAlertsPerEvent=500
# The expiry sweep runs in the WORKER and nowhere else, exactly as every sweeper before it.
Reviews__SweepEnabled=false
Reviews__SweepIntervalMinutes=30
Reviews__SweepBatchSize=500

# --- Reporting (Step 21) ---
# No credentials of any kind: every number is computed from this platform's own facts, written by
# integration-event handlers into the reporting schema (ADR-021). What is here is how hard the two
# background jobs may work and how much of a result one caller may ask for.
Reporting__CurrencyCode=INR
Reporting__MaxReportRows=5000
Reporting__MaxPeriodDays=1100
# The nightly stock-ageing snapshot runs in the WORKER. It is the only scheduled write of a fact in
# the module, and it exists because ageing is the one inventory number no event carries: a stock
# level says what the balance is, never when the units making it up arrived. Midnight UTC is a
# quarter to six in the morning in India, which is the quietest the store gets.
Reporting__SnapshotEnabled=false
Reporting__SnapshotHourUtc=0
Reporting__SnapshotCheckIntervalMinutes=30
Reporting__SnapshotPageSize=250
Reporting__MaxSnapshotLines=100000
# Scheduled exports run in the WORKER, and also need the reporting.scheduled-exports feature flag,
# which ships OFF: a schedule emails the store's takings on a timetable, and somebody should have
# decided who is on that list.
Reporting__SchedulerEnabled=false
Reporting__SchedulerIntervalMinutes=5
Reporting__SchedulerBatchSize=5
# A produced report is served by a signed URL minted per request rather than a stored one. It is a
# private document - the store's takings, or one seller's - and a durable link is one somebody
# pastes into a chat thread that outlives their employment. Exports are stored under
# reporting/exports/ in the PRIVATE bucket, never the media library: that library identifies what it
# accepts by sniffing magic numbers and CSV has none, so teaching it to take one would weaken the
# control that stops the store serving executable content from its own domain.
Reporting__DownloadLinkMinutes=15
Reporting__ExportRetentionDays=90

# --- Notification queue (Step 8) ---
# The dispatcher runs in the WORKER and nowhere else. Every API replica polling the same queue
# would multiply the work and contend for the same rows for no gain.
Notifications__DispatcherEnabled=false
Notifications__PollIntervalSeconds=5
Notifications__BatchSize=25
# Attempts before a message is given up on, and the backoff between them: 30s, 60s, 120s ... to a
# ceiling of an hour, with jitter, so a backlog released by a recovering SMTP host does not arrive
# all in the same second.
Notifications__MaxAttempts=6
Notifications__RetryBaseSeconds=30
Notifications__RetryMaxSeconds=3600
Notifications__DefaultLocale=en-IN

# --- SMS / WhatsApp (Step 8 - DLT registration required in India) ---
# EMPTY, AND EXPECTED TO BE. There is no SMS account (docs/08-integrations.md section 7), so every
# SMS is recorded as Suppressed / NoProvider rather than failing or being silently dropped
# (ADR-017). Outside Production an SMS is delivered to Mailpit instead, addressed to
# <digits>@sms.invalid, so a developer can still complete a mobile-OTP sign-in.
#
# When an account is bought: set Sms__Provider, write the adapter, and register a DLT template id
# against every SMS template in the admin UI. An active SMS template with no id is refused, because
# an Indian operator drops a non-conforming message rather than rejecting it.
Sms__Provider=
Sms__ApiKey=
Sms__SenderId=
Sms__DltEntityId=

# --- Email (Step 8). The one channel that needs no paid account. ---
# Any SMTP host will do; Mailpit answers on the development stack. A managed provider (SES,
# Postmark) is still wanted for deliverability, DKIM and bounce handling - that would be a second
# IChannelSender, not a change here.
Email__Provider=smtp
Email__ApiKey=
Email__FromAddress=no-reply@klarahome.localhost
Email__FromName=
Email__Smtp__Host=mailpit
Email__Smtp__Port=1025
Email__Smtp__UserName=
Email__Smtp__Password=
# False only because Mailpit speaks plain SMTP on the compose network. An SMTP submission in the
# clear carries the password and the message; never false outside development.
Email__Smtp__UseTls=false

# --- Tenant / white-label (Step 6) ---
# The tenant is the deployment's identity, and it is configuration rather than data: onboarding a
# second business means a second installation with a different code, name and id here. Everything
# else a business would want to change - branding, legal entity, GSTIN, support contacts, return
# window, COD cap - lives in platform.store_settings, is editable in the admin UI and is audited.
# Nothing in this file is read after the first deploy has seeded those settings.
Tenant__Code=klarahome
# Display name of the business. Seeded into platform.tenants and used as the initial store name in
# the branding settings, so a fresh install is already branded. Falls back to Tenant__Code.
Tenant__Name=Klara Home
Tenant__DefaultLocale=en-IN
Tenant__DefaultTimeZone=Asia/Kolkata
# Written into tenant_id on every row. Leave blank in development and it is derived
# deterministically from Tenant__Code, which survives a restart. SET IT EXPLICITLY on any
# deployment that holds data: changing the code would otherwise change the derived id and
# strand every row already written under the old one. The platform-tenant readiness check
# reports exactly that failure rather than letting the deployment serve an empty catalogue.
Tenant__Id=

# --- Platform module (Step 6) ---
# Path, inside the container, to the India Post PIN code CSV: a header row, then
# pincode,city,district,stateCode,zone. The dataset is roughly nineteen thousand rows, it changes
# without notice, and it is therefore mounted rather than shipped. Leave blank and the import is
# skipped; keep the platform.pincode-lookup feature flag off until it has run.
Platform__PincodeDataPath=

# --- Identity & Access (Step 7) ---
# The RSA private key access tokens are signed with, PEM (PKCS#8) with newlines written as the
# two characters \n rather than real line breaks, because a value here is one line. Blank in
# development: the host mints an ephemeral key and warns on every start. Every other environment
# refuses to boot without one, because an ephemeral key differs per replica and is discarded on
# restart, signing every user out without explanation.
#
# Generate one with:
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 | awk '{printf "%s\n", $0}'
#
# Rotation is an overlapping window rather than a flag day: add a second key at index 1 in the
# compose file, move the new one to index 0, and drop the old one once the last token signed with
# it has expired: fifteen minutes by default.
AUTH_SIGNING_KEY_ID=
AUTH_SIGNING_KEY_PEM=

# AES-256-GCM key protecting the TOTP secrets at rest. Base64 of exactly 32 bytes:
#   openssl rand -base64 32
# The default below is a fixed development key and is worthless as a secret - it is in this file.
# Anything that holds real enrolments needs its own.
AUTH_ENCRYPTION_KEY_ID=dev
AUTH_ENCRYPTION_KEY=a2xhcmFob21lLWRldmVsb3BtZW50LW9ubHkta2V5ISE=

# Column encryption (Step 9) - protects business values the application must be able to read back
# but must not store in the clear, today a vendor's bank account number. Base64 of exactly 32 bytes,
# same shape as AUTH_ENCRYPTION_KEY. Keep every key you have ever written under in Encryption__Keys
# so a rotation is an overlapping window rather than an outage.
#   openssl rand -base64 32
ENCRYPTION_KEY_ID=dev
ENCRYPTION_KEY=a2xhcmFob21lLWRldmVsb3BtZW50LW9ubHkta2V5ISE=

# The refresh cookie is Secure everywhere it matters. False in the dev stack only, because a
# browser will not return a Secure cookie over plain http and sign-in would appear to fail with
# no error anywhere. Never false in staging or production.
AUTH_REFRESH_COOKIE_SECURE=false

# The anonymous basket's cookie, for the same reason and with the same exception: a browser will
# not return a Secure cookie over the dev stack's plain http, and the basket would appear to empty
# itself on every page. Never false in staging or production.
CART_COOKIE_SECURE=false

# The first platform administrator, created once on an empty deployment and never again. Blank by
# default and deliberately so: a product that ships with a known administrator password is
# compromised the day it is deployed. Their first sign-in enrols a second factor before it issues
# a session, because platform-admin cannot operate without one.
AUTH_BOOTSTRAP_EMAIL=
AUTH_BOOTSTRAP_PASSWORD=

# --- Storefront sign-in ---
# The customer's account is keyed on their email address. Mobile-number-plus-one-time-code sign-in
# has been withdrawn from the storefront: it needs a DLT-registered SMS route this deployment does
# not have, and the development stand-in wrote one-time codes to the API log, which
# docs/07-security-compliance.md forbids in a deployed environment.
#
# Nothing here binds it. The switch is the `identity.mobile-otp-login` feature flag, which now
# ships OFF for a new database. A database created before this change still has it ON, and an
# operator turns it off with:
#
#   PUT /api/v1/admin/feature-flags/identity.mobile-otp-login   { "isEnabled": false }
#
# — audited, and reversible the day an SMS provider is paid for. The endpoints behind it are kept
# rather than deleted (ADR-014 decision 4).

# --- Identity providers (Step 7A) ---
# Customers sign in with Google, or with an email address and a password. There is no
# sign-in-with-a-code option any more (see IDENTITY_MOBILE_OTP note above); the email address is
# the account. Free: an OAuth client and a consent screen, no app review, no verification for
# these scopes (ADR-014).
#
#   1. console.cloud.google.com -> APIs & Services -> Credentials -> OAuth client ID -> Web
#   2. Authorised redirect URI:  <AUTH_EXTERNAL_CALLBACK_BASE_URL>/api/v1/store/auth/external/google/callback
#   3. Paste the client id and secret below, and set AUTH_GOOGLE_ENABLED=true.
#
# **This is what decides whether the "Continue with Google" button exists.** The storefront asks
# GET /store/auth/external/providers and draws a button per provider it answers with; a provider
# with no client id and secret is deliberately not answered with, because a button that fails when
# somebody presses it is worse than no button. Blank here therefore means no buttons on the sign-in
# page, which is the correct state for a deployment that has not created an OAuth client yet — not
# a fault to go looking for in the front end.
AUTH_GOOGLE_ENABLED=false
AUTH_GOOGLE_CLIENT_ID=
AUTH_GOOGLE_CLIENT_SECRET=

# Facebook is designed for and left off: it cannot leave development mode until the business
# verification is complete and a privacy policy is published. Enabling it also needs the schema
# note in ADR-014 addressed, because a Facebook account may carry no email address at all.
AUTH_FACEBOOK_ENABLED=false
AUTH_FACEBOOK_CLIENT_ID=
AUTH_FACEBOOK_CLIENT_SECRET=

# The public origin the provider redirects back to, with no trailing slash. It must match the
# redirect URI registered with the provider exactly, and it is configured rather than derived from
# the request because a forwarded Host header is attacker-controlled.
AUTH_EXTERNAL_CALLBACK_BASE_URL=https://api.klarahome.localhost

# Where the storefront may be sent after signing in. An allow-list: returnUrl arrives from the
# caller, and an unchecked one on the endpoint that has just issued a session is a phishing tool.
AUTH_EXTERNAL_ALLOWED_RETURN_URL=https://klarahome.localhost
AUTH_EXTERNAL_DEFAULT_RETURN_URL=https://klarahome.localhost/

# --- Payments (Step 15) ---
# Razorpay. Blank by default, and that is the shippable state: with no key pair the gateway adapter
# reports itself unusable, a prepaid placement answers 503 PAYMENT_PROVIDER_UNAVAILABLE naming the
# reason, and cash on delivery keeps working end to end. Filling these in is the whole of turning
# online payment on - no rebuild, no code change.
#
#   1. dashboard.razorpay.com -> Settings -> API Keys -> Generate Test Key
#      (a Test key pair works without the account being activated, which is what a sandbox is)
#   2. Settings -> Webhooks -> Add New Webhook
#        URL:    <public API origin>/api/v1/webhooks/razorpay
#        Secret: whatever you put in RAZORPAY_WEBHOOK_SECRET below - it is yours to choose
#        Events: payment.authorized, payment.captured, payment.failed, order.paid,
#                refund.created, refund.processed, refund.failed, settlement.processed
#   3. Paste the key id, the key secret and that webhook secret below.
#
# The key id is publishable and reaches the browser by design - it is what the checkout widget is
# initialised with. The other two never leave the server, are never logged and are never returned
# by any endpoint.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# The merchant account number, in the form the dashboard shows it. Needed by the settlement and
# payout APIs; settlement ingestion is skipped without it rather than failing.
RAZORPAY_ACCOUNT_NUMBER=

# --- Shipping (Step 16; Shiprocket at Step 16A) ---
# The courier. Blank by default, and that is the shippable state: with no credentials the manual
# adapter takes over, an operator books at a courier counter and types the air waybill in, and the
# label, the order timeline, the tracking entries and the cash reconciliation all work exactly as
# they would with an API. Filling these in is the whole of turning a courier on - no rebuild, no
# code change, and no caller in this codebase names Shiprocket (ADR-018).
#
#   1. Open a Shiprocket account and create an API user (Settings -> API -> Configure). That
#      user's email and password are SHIPPING_API_USER and SHIPPING_API_SECRET; they are
#      exchanged for a token that expires in days, which is why a bare token is not enough.
#   2. Register each seller's pickup address with Shiprocket; the platform records the code it is
#      registered under the first time a parcel is booked from it.
#   3. Add a webhook:
#        URL:    <public API origin>/api/v1/webhooks/shipping/shiprocket
#        Secret: whatever you put in SHIPPING_WEBHOOK_SECRET below - it is yours to choose.
#                Shiprocket sends it back in an x-api-key header; there is no HMAC.
#        Events: tracking updates, delivery, failed delivery, return to origin
#   4. Paste the base URL, the credentials and that webhook secret below.
#
# SHIPPING_BASE_URL is both the endpoint and the outbound allow-list: the client refuses to talk to
# any other host, so a wrong value fails at the socket rather than at somebody else's server with
# this deployment's token in the header. For Shiprocket it is https://apiv2.shiprocket.in
#
# WHERE THE STORE DELIVERS IS NOT HERE. Delivery coverage - Hyderabad only by default - is a store
# setting an operator edits in admin (Settings -> Delivery coverage), because it is a trading
# decision that changes without a deploy. This block only decides who carries the parcel.
SHIPPING_PROVIDER=
SHIPPING_BASE_URL=
SHIPPING_API_KEY=
SHIPPING_API_USER=
SHIPPING_API_SECRET=
SHIPPING_WEBHOOK_SECRET=

# --- Search engine (Step 19) ---
# Which engine answers a query. Blank is PostgreSQL full text, which is the working state and not a
# degraded one: it needs no credentials, no second container and no network hop, so search works in
# every deployment on the day it is installed (ADR-007, ADR-019). A dedicated engine also needs the
# search.external-engine feature flag switched on in admin, and falls back to PostgreSQL with a log
# line if its credentials are blank rather than leaving a store with no search.
SEARCH_PROVIDER=
SEARCH_BASE_URL=
SEARCH_API_KEY=

# Whether Route is enabled on this merchant account. Acted on at Step 18: the Route payout adapter
# reports itself unusable unless this is true AND the key pair is present, because a transfer to a
# linked account on a merchant without Route enabled fails at the gateway rather than here.
RAZORPAY_ROUTE_ENABLED=false

# --- Vendor payouts (Step 18) ---
# Which rail money to a seller travels on. Blank sends nothing and says so: batches are still built,
# approved and recorded, and the transfer answers 503 PAYOUT_PROVIDER_UNAVAILABLE.
#   route  Razorpay Route - a transfer to the seller's linked account at the gateway. Needs
#          RAZORPAY_ROUTE_ENABLED=true and a linked account per seller, created at activation.
#   x      RazorpayX - a direct bank payout drawn from RAZORPAY_ACCOUNT_NUMBER, which has to be
#          funded. A payout the gateway would queue for want of balance is refused rather than
#          queued: money that moves at an unpredictable time is money the ledger cannot reconcile.
PAYOUTS_PROVIDER=

# The rail a direct bank payout is sent on: IMPS, NEFT or RTGS. Read only by the X adapter - Route
# settles on the gateway's own schedule and takes no mode. IMPS clears at any hour, which is what
# stops a seller waiting for money over a weekend.
PAYOUTS_MODE=IMPS

# What a seller sees on their bank statement. A bank truncates anything past thirty characters, so
# it is trimmed here rather than in the middle of a word on somebody's statement.
PAYOUTS_NARRATION=Marketplace payout

# The API root. Razorpay has no separate sandbox host - a Test key pair against the live host is
# the sandbox - so this changes only for a proxy or a recorded fixture.
RAZORPAY_BASE_URL=https://api.razorpay.com/v1/

# Which provider prepaid collections are opened with. Named rather than inferred, so a deployment
# with credentials for two gateways still collects through exactly one.
PAYMENTS_PROVIDER=razorpay

# Whether cancelling a paid order refunds it without anybody asking. The value above which a refund
# needs a second signature is NOT here: it is the `payments` store-settings section, because it is a
# governance decision a business revisits without a deploy (docs/07-security-compliance.md 4).
PAYMENTS_AUTO_REFUND_ON_CANCELLATION=true

# How long after placement a shopper may still retry a failed payment. Deliberately longer than the
# unpaid-order timeout that cancels the order and releases its stock.
PAYMENTS_RETRY_WINDOW_HOURS=24

# --- Database (Step 4) ---
# The connection string itself is composed by compose from POSTGRES_* above; these are the
# behavioural knobs.
Database__CommandTimeoutSeconds=30
Database__MaxRetryCount=3
Database__MaxRetryDelaySeconds=10
# MUST stay false outside development. Migrations are applied by the migrator job before the
# new API version starts (docs/03-database-design.md 7); the API refuses to boot in Production
# with this set.
DATABASE_MIGRATE_ON_STARTUP=false
# Logs EF parameter values, including personal data. Development only; refused in Production.
DATABASE_SENSITIVE_LOGGING=false
# Whether the migrator runs the seeders after migrating. Turn off for a schema-only restore drill.
DATABASE_RUN_SEEDERS=true

# --- Demonstration catalogue ---
# A small sample catalogue so a freshly migrated stack is not an empty shop: one seller
# (DEMO-ATELIER), two category branches, three brands and ten products, each with a live offer.
# Everything it writes is keyed on a DEMO- SKU or a demo- slug, so it is idempotent and an operator
# can see at a glance which rows are not real.
#
# Off by default and REFUSED OUTRIGHT IN PRODUCTION, at registration and again inside the seeder,
# whatever this says. Turn it on for a local stack, a demo environment or a design review:
#
#   DEMO_SEED_CATALOG=true  ./infra/scripts/dev.sh reset
#
# It writes no stock rows and no product images on purpose. The buy box treats unknown stock as
# "do not discriminate" rather than as unavailable, so the offers still render; and the products
# show the placeholder media treatment, which is what they should look like until real photography
# is supplied.
DEMO_SEED_CATALOG=false

# --- Outbox dispatcher (Step 4; runs in the worker only) ---
Outbox__Enabled=true
Outbox__PollIntervalSeconds=5
Outbox__BatchSize=50
# Delivery attempts before a message is left alone for inspection. Retries are spaced by the
# poll interval, so this is a budget in polls rather than milliseconds.
Outbox__MaxAttempts=8

# --- Observability (Step 31) ---
Observability__OtlpEndpoint=
Observability__ServiceName=klarahome-api

# --- Feature flags ---
# Feature flags are NOT configuration. They live in platform.feature_flags, are declared in code
# by the module that reads them, and are toggled at runtime through
# PUT /api/v1/admin/feature-flags/{key} - so an operator can turn something off without a deploy
# and the change is audited. Nothing binds a FeatureFlags__* variable.

# ================================================================================================
# FRONTEND (Step 22)
# ================================================================================================
# The two Angular apps are each built ONCE and run in every environment and for every tenant.
# There is no environment.prod.ts and no per-environment build: what differs is a config.json
# served beside the bundle (docs/05-frontend-architecture.md 5).
#
#   - The browser reads /config.json before the app bootstraps. In a container that file is
#     written from these variables at start-up; in development it is the checked-in
#     apps/<app>/public/config.json.
#   - The storefront ALSO renders on Node, where there is no file to fetch. That process reads
#     these variables directly (runtimeConfigFromEnv). The two paths must agree, which is why the
#     names are the same on both sides.

# Where the API is hosted. NO path and no trailing slash: every generated client method already
# carries its own /api/v1/... prefix, because the version belongs to the contract and not to the
# deployment. Setting this to ".../api/v1" produces 404s on every call.
KH_API_BASE_URL=https://api.klarahome.localhost

KH_TENANT_CODE=klarahome
KH_LOCALE=en-IN
KH_TIME_ZONE=Asia/Kolkata
# local | development | staging | production
KH_ENVIRONMENT=local

# No longer read. An image known only by file id is fetched through the API's own
# GET /store/media/{fileId}/image?width= route, which redirects to the right imgproxy rendition
# (or the original) - only the media module knows the object key and the signature. Kept so an
# existing compose file that sets it keeps working; it changes nothing.
KH_IMAGE_BASE_URL=

# Analytics is off unless a provider is named. A tenant that has not consented gets an app with no
# tracking in it, rather than an app whose tracking fails quietly (docs/05-frontend-architecture 5).
KH_ANALYTICS_PROVIDER=
KH_ANALYTICS_MEASUREMENT_ID=

# --- The SSR process (Step 23) ---
# The storefront's Node renderer refuses a request whose Host header it does not recognise. With
# an empty list that is EVERY request - the process answers 400 to everything, which only shows up
# once it is behind a real hostname. It is a genuine protection (a forged Host is how a
# server-side renderer becomes an open redirect or an SSRF hop), so it is configured rather than
# switched off. Comma-separated; "*.klarahome.example" is allowed; "*" allows everything and
# should never be used in production.
KH_ALLOWED_HOSTS=klarahome.localhost,www.klarahome.localhost,localhost,127.0.0.1,[::1]

# Whether X-Forwarded-* and Forwarded may be believed. True in this platform's deployments, where
# Traefik terminates TLS and is the only thing that can reach the renderer. It must stay false
# anywhere the process is directly reachable: a header an end user can set is not evidence.
KH_TRUST_PROXY_HEADERS=true

# Feature flags reach the frontend as KH_FEATURE_<key>, where "__" is a dot and "_" is a hyphen:
# KH_FEATURE_search__external_engine=true is the flag "search.external-engine". This is only the
# client's SEED - the app refreshes the real set from GET /store/config once it is running, and the
# API is the only thing that ENFORCES a flag. A hidden button is a courtesy, not a control.
