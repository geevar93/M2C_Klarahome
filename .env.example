# =============================================================================
# Klara Home - environment variables
# =============================================================================
# Copy to `.env` and edit. `.env` is git-ignored and must NEVER be committed.
#
#   cp .env.example .env
#
# Two groups live here:
#   1. LOCAL DEV STACK  - consumed by infra/compose/docker-compose.dev.yml today.
#                         Every one of these has a working default baked into the
#                         compose file, so the stack starts even with no .env.
#   2. APPLICATION      - the variable names the API/worker bind from
#                         (docs/06-infrastructure-devops.md #4.1).
#                         The api container gets the ones it needs today directly
#                         from the compose file, derived from the values in
#                         group 1; the rest are documented for the steps that
#                         introduce them.
#
# Production secrets are NOT delivered this way: they are Docker secrets or a
# SOPS-encrypted file, mounted by path via the `*__File` convention.
# =============================================================================


# -----------------------------------------------------------------------------
# 1. LOCAL DEV STACK
# -----------------------------------------------------------------------------

# --- Compose ---
# Prefixes container, network and volume names. Change it to run two isolated
# stacks side by side (e.g. klarahome-dev and klarahome-scratch).
COMPOSE_PROJECT_NAME=klarahome-dev

# Host interface the published ports bind to. 127.0.0.1 keeps every service off
# the LAN. Set to 0.0.0.0 only to test from a phone on the same network.
BIND_ADDRESS=127.0.0.1

# Base hostname for the Traefik routers. Browsers resolve *.localhost to the
# loopback address without any hosts-file entry.
DEV_DOMAIN=klarahome.localhost

# --- Traefik ---
HTTP_PORT=80
HTTPS_PORT=443

# --- PostgreSQL 18 ---
POSTGRES_DB=klarahome
POSTGRES_USER=klarahome
POSTGRES_PASSWORD=klarahome_dev_password
# Change if a native PostgreSQL already owns 5432 (common on Windows).
POSTGRES_PORT=5432

# --- Redis 8 ---
REDIS_PASSWORD=klarahome_dev_password
REDIS_PORT=6379

# --- MinIO (S3-compatible object storage) ---
MINIO_ROOT_USER=klarahome
MINIO_ROOT_PASSWORD=klarahome_dev_password
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
# Buckets created by the minio-init one-shot (docs/08-integrations.md #4).
STORAGE_PUBLIC_BUCKET=media-public
STORAGE_PRIVATE_BUCKET=docs-private

# --- Mailpit (captures all outbound email in dev) ---
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# --- API container (Step 3) ---
# Reachable only through Traefik at https://api.${DEV_DOMAIN}. It publishes no
# host port of its own.
#   up:      ./infra/scripts/dev.ps1 up
#   rebuild: docker compose -f infra/compose/docker-compose.dev.yml --env-file .env up -d --build api
API_IMAGE_TAG=dev
API_BUILD_CONFIGURATION=Release
# Debug|Development|Staging|Production. Development turns on the Scalar API
# reference and the diagnostics endpoints.
ASPNETCORE_ENVIRONMENT=Development
# Containers log JSON so a shipper can read them; set false to get the
# human-readable console template in `docker logs`.
OBSERVABILITY_CONSOLE_JSON=true
# Empty in dev: telemetry is collected but not exported until the collector
# arrives with Step 31.
OBSERVABILITY_OTLP_ENDPOINT=
# White-label identity of this deployment (ADR-006). Stamped on every log line, seeded into
# platform.tenants, and used as the initial store name in the branding settings.
TENANT_CODE=klarahome
TENANT_NAME=Klara Home
TENANT_DEFAULT_LOCALE=en-IN
TENANT_DEFAULT_TIMEZONE=Asia/Kolkata
# The tenant id written into tenant_id on every row. Blank in dev: it is derived from
# TENANT_CODE, which survives a restart but not a change of code. Set it explicitly on any
# deployment that holds data.
TENANT_ID=
# Path inside the container to the India Post PIN code CSV. infra/seed is mounted at /app/seed,
# so dropping pincodes.csv there and re-running the migrator imports it. Blank: import skipped.
PINCODE_DATA_PATH=


# -----------------------------------------------------------------------------
# 2. APPLICATION (documented now, consumed from Step 3 onwards)
# -----------------------------------------------------------------------------

# --- Host ---
# ASPNETCORE_ENVIRONMENT is set in group 1, where the container reads it.
# Set per container by compose: api | worker | migrator
APP_ROLE=api

# --- Data ---
# Host names below are the compose service names, resolved on the data network.
# The api container receives these already composed from the group 1 values;
# they are repeated here as the documented contract for staging and production.
ConnectionStrings__Postgres=Host=postgres;Port=5432;Database=klarahome;Username=klarahome;Password=klarahome_dev_password
ConnectionStrings__Redis=redis:6379,password=klarahome_dev_password

# --- Object storage (S3 API - MinIO in dev, S3/R2 in production) ---
Storage__Endpoint=http://minio:9000
Storage__AccessKey=klarahome
Storage__SecretKey=klarahome_dev_password
Storage__Bucket=media-public
Storage__PrivateBucket=docs-private
Storage__Region=ap-south-1
Storage__ForcePathStyle=true
Storage__PublicBaseUrl=https://s3.klarahome.localhost/media-public

# --- Authentication ---
# Development value only. Production uses a rotated secret from Docker secrets.
Jwt__Issuer=https://api.klarahome.localhost
Jwt__Audience=klarahome
Jwt__SigningKey=CHANGE_ME_dev_only_at_least_32_characters_long
Jwt__AccessTokenMinutes=15
Jwt__RefreshTokenDays=30

# --- Payments: Razorpay (Step 15 - sandbox credentials not yet provisioned) ---
Razorpay__KeyId=
Razorpay__KeySecret=
Razorpay__WebhookSecret=
Razorpay__RouteEnabled=false

# --- Shipping / logistics aggregator (Step 16 - not yet provisioned) ---
Shipping__Provider=
Shipping__ApiKey=
Shipping__WebhookSecret=

# --- SMS / WhatsApp (Step 8 - DLT registration required in India) ---
Sms__Provider=
Sms__ApiKey=
Sms__SenderId=
Sms__DltEntityId=

# --- Email (Step 8). In dev the provider is smtp, pointed at Mailpit. ---
Email__Provider=smtp
Email__ApiKey=
Email__FromAddress=no-reply@klarahome.localhost
Email__Smtp__Host=mailpit
Email__Smtp__Port=1025

# --- Tenant / white-label (Step 6) ---
# The tenant is the deployment's identity, and it is configuration rather than data: onboarding a
# second business means a second installation with a different code, name and id here. Everything
# else a business would want to change - branding, legal entity, GSTIN, support contacts, return
# window, COD cap - lives in platform.store_settings, is editable in the admin UI and is audited.
# Nothing in this file is read after the first deploy has seeded those settings.
Tenant__Code=klarahome
# Display name of the business. Seeded into platform.tenants and used as the initial store name in
# the branding settings, so a fresh install is already branded. Falls back to Tenant__Code.
Tenant__Name=Klara Home
Tenant__DefaultLocale=en-IN
Tenant__DefaultTimeZone=Asia/Kolkata
# Written into tenant_id on every row. Leave blank in development and it is derived
# deterministically from Tenant__Code, which survives a restart. SET IT EXPLICITLY on any
# deployment that holds data: changing the code would otherwise change the derived id and
# strand every row already written under the old one. The platform-tenant readiness check
# reports exactly that failure rather than letting the deployment serve an empty catalogue.
Tenant__Id=

# --- Platform module (Step 6) ---
# Path, inside the container, to the India Post PIN code CSV: a header row, then
# pincode,city,district,stateCode,zone. The dataset is roughly nineteen thousand rows, it changes
# without notice, and it is therefore mounted rather than shipped. Leave blank and the import is
# skipped; keep the platform.pincode-lookup feature flag off until it has run.
Platform__PincodeDataPath=

# --- Database (Step 4) ---
# The connection string itself is composed by compose from POSTGRES_* above; these are the
# behavioural knobs.
Database__CommandTimeoutSeconds=30
Database__MaxRetryCount=3
Database__MaxRetryDelaySeconds=10
# MUST stay false outside development. Migrations are applied by the migrator job before the
# new API version starts (docs/03-database-design.md 7); the API refuses to boot in Production
# with this set.
DATABASE_MIGRATE_ON_STARTUP=false
# Logs EF parameter values, including personal data. Development only; refused in Production.
DATABASE_SENSITIVE_LOGGING=false
# Whether the migrator runs the seeders after migrating. Turn off for a schema-only restore drill.
DATABASE_RUN_SEEDERS=true

# --- Outbox dispatcher (Step 4; runs in the worker only) ---
Outbox__Enabled=true
Outbox__PollIntervalSeconds=5
Outbox__BatchSize=50
# Delivery attempts before a message is left alone for inspection. Retries are spaced by the
# poll interval, so this is a budget in polls rather than milliseconds.
Outbox__MaxAttempts=8

# --- Observability (Step 31) ---
Observability__OtlpEndpoint=
Observability__ServiceName=klarahome-api

# --- Feature flags ---
# Feature flags are NOT configuration. They live in platform.feature_flags, are declared in code
# by the module that reads them, and are toggled at runtime through
# PUT /api/v1/admin/feature-flags/{key} - so an operator can turn something off without a deploy
# and the change is audited. Nothing binds a FeatureFlags__* variable.
