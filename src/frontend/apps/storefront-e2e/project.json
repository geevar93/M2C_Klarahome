{
  "name": "storefront-e2e",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/storefront-e2e/src",
  "implicitDependencies": ["storefront"],
  "// targets": "to see all targets run: nx show project storefront-e2e --web",
  "targets": {
    "visual-regression": {
      "executor": "nx:run-commands",
      "options": {
        "command": "playwright test --config=apps/storefront-e2e/playwright.visual.config.mts",
        "cwd": "."
      }
    },
    "responsive-qa": {
      "executor": "nx:run-commands",
      "options": {
        "command": "playwright test --config=apps/storefront-e2e/playwright.responsive.config.mts",
        "cwd": "."
      }
    }
  }
}
