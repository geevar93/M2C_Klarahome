<Project Sdk="Microsoft.NET.Sdk">

  <!-- Fast, in-process tests: domain primitives, the dispatcher, and the error mapping. -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>KlaraHome.UnitTests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../shared/KlaraHome.SharedKernel/KlaraHome.SharedKernel.csproj" />
    <ProjectReference Include="../../shared/KlaraHome.Contracts/KlaraHome.Contracts.csproj" />
    <ProjectReference Include="../../shared/KlaraHome.Infrastructure/KlaraHome.Infrastructure.csproj" />
    <ProjectReference Include="../../modules/KlaraHome.Modules.Platform/KlaraHome.Modules.Platform.csproj" />
    <ProjectReference Include="../../modules/KlaraHome.Modules.Identity/KlaraHome.Modules.Identity.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="NSubstitute" />
  </ItemGroup>

  <ItemGroup Label="Shared test model">
    <!--
      One fixture, linked into both test projects: the unit tests assert the model's shape without
      a database, the integration tests assert its behaviour against a real one. Two copies would
      drift, and the drift would look like a passing suite.
    -->
    <Compile Include="../Shared/ConventionsModel.cs" Link="Persistence/ConventionsModel.cs" />
  </ItemGroup>

</Project>
