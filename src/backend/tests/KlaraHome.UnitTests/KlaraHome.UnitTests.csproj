<Project Sdk="Microsoft.NET.Sdk">

  <!-- Fast, in-process tests: domain primitives, the dispatcher, and the error mapping. -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>KlaraHome.UnitTests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../shared/KlaraHome.SharedKernel/KlaraHome.SharedKernel.csproj" />
    <ProjectReference Include="../../shared/KlaraHome.Contracts/KlaraHome.Contracts.csproj" />
    <ProjectReference Include="../../shared/KlaraHome.Infrastructure/KlaraHome.Infrastructure.csproj" />
    <ProjectReference Include="../../modules/KlaraHome.Modules.Platform/KlaraHome.Modules.Platform.csproj" />
    <ProjectReference Include="../../modules/KlaraHome.Modules.Identity/KlaraHome.Modules.Identity.csproj" />
    <ProjectReference Include="../../modules/KlaraHome.Modules.Media/KlaraHome.Modules.Media.csproj" />
    <ProjectReference Include="../../modules/KlaraHome.Modules.Notifications/KlaraHome.Modules.Notifications.csproj" />
    <ProjectReference Include="../../modules/KlaraHome.Modules.Vendors/KlaraHome.Modules.Vendors.csproj" />
    <ProjectReference Include="../../modules/KlaraHome.Modules.Catalog/KlaraHome.Modules.Catalog.csproj" />
    <ProjectReference Include="../../modules/KlaraHome.Modules.Inventory/KlaraHome.Modules.Inventory.csproj" />
    <ProjectReference Include="../../modules/KlaraHome.Modules.Pricing/KlaraHome.Modules.Pricing.csproj" />
    <ProjectReference Include="../../modules/KlaraHome.Modules.Carts/KlaraHome.Modules.Carts.csproj" />
    <ProjectReference Include="../../modules/KlaraHome.Modules.Orders/KlaraHome.Modules.Orders.csproj" />
    <ProjectReference Include="../../modules/KlaraHome.Modules.Payments/KlaraHome.Modules.Payments.csproj" />
    <ProjectReference Include="../../modules/KlaraHome.Modules.Shipping/KlaraHome.Modules.Shipping.csproj" />
    <ProjectReference Include="../../modules/KlaraHome.Modules.Settlements/KlaraHome.Modules.Settlements.csproj" />
    <ProjectReference Include="../../modules/KlaraHome.Modules.Search/KlaraHome.Modules.Search.csproj" />
    <ProjectReference Include="../../modules/KlaraHome.Modules.Content/KlaraHome.Modules.Content.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="NSubstitute" />
  </ItemGroup>

  <ItemGroup Label="Shared test model">
    <!--
      One fixture, linked into both test projects: the unit tests assert the model's shape without
      a database, the integration tests assert its behaviour against a real one. Two copies would
      drift, and the drift would look like a passing suite.
    -->
    <Compile Include="../Shared/ConventionsModel.cs" Link="Persistence/ConventionsModel.cs" />
  </ItemGroup>

</Project>
