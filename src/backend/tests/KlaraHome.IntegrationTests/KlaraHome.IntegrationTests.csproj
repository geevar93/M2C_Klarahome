<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    Drives the real API host in-process through WebApplicationFactory, so what is asserted is the
    actual middleware pipeline and the actual error contract, not a reconstruction of them.

    Testcontainers-backed database tests arrive with the data layer in Step 4.
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>KlaraHome.IntegrationTests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../host/KlaraHome.Api/KlaraHome.Api.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
  </ItemGroup>

</Project>
