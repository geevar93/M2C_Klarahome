<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Cross-cutting composition: the module convention, the in-house dispatcher, the error model,
    correlation, observability, options validation, rate limiting, caching and health.

    This project owns the ASP.NET Core dependency so that modules and hosts do not each
    re-invent middleware wiring. It must never contain business logic.
  -->

  <PropertyGroup>
    <RootNamespace>KlaraHome.Infrastructure</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../KlaraHome.SharedKernel/KlaraHome.SharedKernel.csproj" />
    <ProjectReference Include="../KlaraHome.Contracts/KlaraHome.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="FluentValidation" />
    <PackageReference Include="FluentValidation.DependencyInjectionExtensions" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Serilog.AspNetCore" />
    <PackageReference Include="Serilog.Sinks.Console" />
    <PackageReference Include="Serilog.Formatting.Compact" />
    <PackageReference Include="Serilog.Enrichers.Environment" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" />
    <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Http" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Runtime" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" />
    <PackageReference Include="AspNetCore.HealthChecks.NpgSql" />
    <PackageReference Include="AspNetCore.HealthChecks.Redis" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="KlaraHome.UnitTests" />
    <InternalsVisibleTo Include="KlaraHome.IntegrationTests" />
    <InternalsVisibleTo Include="KlaraHome.ArchitectureTests" />
  </ItemGroup>

</Project>
