{
  "Observability": {
    "ServiceName": "klarahome-worker",
    "MinimumLevel": "Information",
    "TraceSampleRatio": 1.0
  },
  "Tenant": {
    "Code": "klarahome",
    "DefaultLocale": "en-IN",
    "DefaultTimeZone": "Asia/Kolkata"
  },
  "Database": {
    "CommandTimeoutSeconds": 30,
    "MaxRetryCount": 3,
    "MaxRetryDelaySeconds": 10,
    "MigrateOnStartup": false,
    "EnableSensitiveDataLogging": false,
    "RunSeeders": false
  },
  "Outbox": {
    "Enabled": true,
    "PollIntervalSeconds": 5,
    "BatchSize": 50,
    "MaxAttempts": 8
  },
  "Storage": {
    "Bucket": "media-public",
    "PrivateBucket": "docs-private",
    "Region": "ap-south-1",
    "ForcePathStyle": true,
    "SignedUrlMinutes": 10
  },
  "Media": {
    "RequireVirusScan": false
  },
  "Notifications": {
    "DispatcherEnabled": true,
    "PollIntervalSeconds": 5,
    "BatchSize": 25,
    "MaxAttempts": 6,
    "RetryBaseSeconds": 30,
    "RetryMaxSeconds": 3600,
    "DefaultLocale": "en-IN"
  },
  "Catalog": {
    "JobRunnerEnabled": true,
    "JobPollIntervalSeconds": 10,
    "MaxJobAttempts": 3
  },
  "Inventory": {
    "DefaultReservationMinutes": 15,
    "MaxReservationMinutes": 120,
    "ReservationSweeperEnabled": true,
    "SweepIntervalSeconds": 60,
    "SweepBatchSize": 100,
    "ReconciliationEnabled": true,
    "ReconciliationIntervalHours": 24
  },
  "Pricing": {
    "MaxQuoteLines": 100,
    "MaxPromotionCandidates": 100
  },
  "Carts": {
    "CartLifetimeDays": 30,
    "AbandonAfterHours": 4,
    "AbandonedRetentionDays": 60,
    "SweeperEnabled": true,
    "SweepIntervalSeconds": 300,
    "SweepBatchSize": 200
  },
  "Orders": {
    "UnpaidOrderTimeoutMinutes": 60,
    "AutoInvoiceOnPacked": true,
    "SweeperEnabled": true,
    "SweepIntervalSeconds": 300,
    "SweepBatchSize": 200
  },
  "Payments": {
    "EventProcessorEnabled": true,
    "EventPollIntervalSeconds": 5,
    "EventBatchSize": 25,
    "MaxEventAttempts": 8,
    "EventRetryBackoffSeconds": 30,
    "ReconciliationEnabled": true,
    "ReconciliationIntervalMinutes": 15,
    "ReconciliationGraceMinutes": 20,
    "ReconciliationBatchSize": 50,
    "SettlementIngestionEnabled": true,
    "SettlementIntervalHours": 24,
    "SettlementLookbackDays": 3
  },
  "Shipping": {
    "ServiceabilityRefreshEnabled": true,
    "ServiceabilityRefreshIntervalHours": 24,
    "ServiceabilityRefreshBatchSize": 200,
    "EventProcessorEnabled": true,
    "EventPollIntervalSeconds": 5,
    "EventBatchSize": 25,
    "MaxEventAttempts": 8,
    "EventRetryBackoffSeconds": 30,
    "TrackingPollEnabled": true,
    "TrackingPollIntervalMinutes": 30,
    "TrackingSilenceHours": 24,
    "TrackingPollBatchSize": 50
  },
  "Returns": {
    "SweeperEnabled": true,
    "SweepIntervalMinutes": 60,
    "SweepBatchSize": 100
  },
  "Settlements": {
    "SchedulerEnabled": true,
    "SchedulerIntervalMinutes": 60,
    "SchedulerBatchSize": 100,
    "ReconciliationEnabled": true,
    "ReconciliationIntervalMinutes": 15,
    "ReconciliationBatchSize": 50,
    "StaleTransferHours": 24
  },
  "Search": {
    "ReindexEnabled": true,
    "ReindexIntervalMinutes": 15,
    "ReindexBatchSize": 200,
    "StaleAfterHours": 24
  },
  "Content": {
    "SchedulerEnabled": true,
    "SchedulerIntervalSeconds": 60,
    "SchedulerBatchSize": 50,
    "CollectionRefreshEnabled": true,
    "CollectionRefreshIntervalMinutes": 30,
    "CollectionRefreshBatchSize": 5,
    "CollectionStaleAfterHours": 6
  },
  "Email": {
    "Provider": "",
    "FromAddress": "",
    "Smtp": {
      "Port": 587,
      "UseTls": true,
      "TimeoutSeconds": 15
    }
  },
  "Sms": {
    "Provider": ""
  }
}
