{
  "Observability": {
    "ServiceName": "klarahome-worker",
    "MinimumLevel": "Information",
    "TraceSampleRatio": 1.0
  },
  "Tenant": {
    "Code": "klarahome",
    "DefaultLocale": "en-IN",
    "DefaultTimeZone": "Asia/Kolkata"
  },
  "Database": {
    "CommandTimeoutSeconds": 30,
    "MaxRetryCount": 3,
    "MaxRetryDelaySeconds": 10,
    "MigrateOnStartup": false,
    "EnableSensitiveDataLogging": false,
    "RunSeeders": false
  },
  "Outbox": {
    "Enabled": true,
    "PollIntervalSeconds": 5,
    "BatchSize": 50,
    "MaxAttempts": 8
  },
  "Storage": {
    "Bucket": "media-public",
    "PrivateBucket": "docs-private",
    "Region": "ap-south-1",
    "ForcePathStyle": true,
    "SignedUrlMinutes": 10
  },
  "Media": {
    "RequireVirusScan": false
  },
  "Notifications": {
    "DispatcherEnabled": true,
    "PollIntervalSeconds": 5,
    "BatchSize": 25,
    "MaxAttempts": 6,
    "RetryBaseSeconds": 30,
    "RetryMaxSeconds": 3600,
    "DefaultLocale": "en-IN"
  },
  "Email": {
    "Provider": "",
    "FromAddress": "",
    "Smtp": {
      "Port": 587,
      "UseTls": true,
      "TimeoutSeconds": 15
    }
  },
  "Sms": {
    "Provider": ""
  }
}
