{
  "Api": {
    "Version": "v1",
    "EnableApiReference": true,
    "ApiReferencePath": "/scalar",
    "EnableDiagnosticsEndpoints": false,
    "TrustProxyHeaders": true
  },
  "Tenant": {
    "Code": "klarahome",
    "DefaultLocale": "en-IN",
    "DefaultTimeZone": "Asia/Kolkata"
  },
  "Database": {
    "CommandTimeoutSeconds": 30,
    "MaxRetryCount": 3,
    "MaxRetryDelaySeconds": 10,
    "MigrateOnStartup": false,
    "EnableSensitiveDataLogging": false,
    "RunSeeders": true
  },
  "Observability": {
    "ServiceName": "klarahome-api",
    "MinimumLevel": "Information",
    "TraceSampleRatio": 1.0
  },
  "Cors": {
    "AllowedOrigins": [],
    "AllowCredentials": true,
    "PreflightMaxAgeSeconds": 600
  },
  "RateLimiting": {
    "Enabled": true,
    "Global": {
      "PermitLimit": 600,
      "WindowSeconds": 60
    },
    "StorefrontRead": {
      "PermitLimit": 300,
      "WindowSeconds": 60
    },
    "Auth": {
      "PermitLimit": 10,
      "WindowSeconds": 60
    },
    "Otp": {
      "PermitLimit": 20,
      "WindowSeconds": 3600
    },
    "CartWrite": {
      "PermitLimit": 60,
      "WindowSeconds": 60
    },
    "PlaceOrder": {
      "PermitLimit": 5,
      "WindowSeconds": 60
    },
    "AdminWrite": {
      "PermitLimit": 120,
      "WindowSeconds": 60
    }
  },
  "Storage": {
    "Bucket": "media-public",
    "PrivateBucket": "docs-private",
    "Region": "ap-south-1",
    "ForcePathStyle": true,
    "SignedUrlMinutes": 10
  },
  "Media": {
    "MaxImageBytes": 10485760,
    "MaxDocumentBytes": 26214400,
    "MaxImageDimension": 8000,
    "RequireVirusScan": false,
    "VariantWidths": [
      160,
      480,
      960,
      1600
    ],
    "Imgproxy": {
      "Format": "webp"
    }
  },
  "Notifications": {
    "DispatcherEnabled": false,
    "PollIntervalSeconds": 5,
    "BatchSize": 25,
    "MaxAttempts": 6,
    "RetryBaseSeconds": 30,
    "RetryMaxSeconds": 3600,
    "DefaultLocale": "en-IN"
  },
  "Email": {
    "Provider": "",
    "FromAddress": "",
    "Smtp": {
      "Port": 587,
      "UseTls": true,
      "TimeoutSeconds": 15
    }
  },
  "Sms": {
    "Provider": ""
  },
  "Vendors": {
    "CodePrefix": "VND",
    "RequireGstin": false,
    "RequireVerifiedKyc": true,
    "RequireVerifiedBankAccount": true,
    "RequirePickupLocation": true,
    "DefaultDispatchSlaHours": 24,
    "DefaultReturnWindowDays": 7
  },
  "Catalog": {
    "SkuPrefix": "SKU",
    "RequireModeration": true,
    "EnforceComplianceOnPublish": true,
    "AllowListingsFromInactiveVendors": false,
    "MaxImportBytes": 33554432,
    "MaxImportRows": 20000,
    "JobRunnerEnabled": false,
    "JobPollIntervalSeconds": 10,
    "MaxJobAttempts": 3
  },
  "Inventory": {
    "PurchaseOrderPrefix": "PO",
    "GoodsReceiptPrefix": "GRN",
    "StockTakePrefix": "STK",
    "DefaultReservationMinutes": 15,
    "MaxReservationMinutes": 120,
    "ReservationSweeperEnabled": false,
    "SweepIntervalSeconds": 60,
    "SweepBatchSize": 100,
    "ReconciliationEnabled": false,
    "ReconciliationIntervalHours": 24,
    "RequireKnownListing": true,
    "MaxStockTakeLines": 5000
  },
  "Pricing": {
    "MaxQuoteLines": 100,
    "MaxPromotionCandidates": 100,
    "MaxPriceListItemsPerRequest": 1000,
    "RequireKnownListing": true
  },
  "Carts": {
    "CartCookieName": "kh_cart",
    "CartCookieSecure": true,
    "CartLifetimeDays": 30,
    "AbandonAfterHours": 4,
    "AbandonedRetentionDays": 60,
    "MaxLines": 50,
    "CheckoutSessionMinutes": 60,
    "PlacementHoldMinutes": 20,
    "RequireSignInToCheckout": true,
    "SweeperEnabled": false,
    "SweepIntervalSeconds": 300,
    "SweepBatchSize": 200
  },
  "Orders": {
    "OrderNumberPrefix": "KH",
    "OrderNumberDigits": 6,
    "InvoiceNumberDigits": 5,
    "FallbackReturnWindowDays": 7,
    "UnpaidOrderTimeoutMinutes": 60,
    "AutoInvoiceOnPacked": true,
    "MaxPageSize": 50,
    "SweeperEnabled": false,
    "SweepIntervalSeconds": 300,
    "SweepBatchSize": 200
  },
  "Payments": {
    "Provider": "razorpay",
    "AutoCapture": true,
    "RetryWindowHours": 24,
    "WebhookSkewMinutes": 5,
    "MaxWebhookBytes": 262144,
    "EventProcessorEnabled": false,
    "EventPollIntervalSeconds": 5,
    "EventBatchSize": 25,
    "MaxEventAttempts": 8,
    "EventRetryBackoffSeconds": 30,
    "ReconciliationEnabled": false,
    "ReconciliationIntervalMinutes": 15,
    "ReconciliationGraceMinutes": 20,
    "ReconciliationBatchSize": 50,
    "SettlementIngestionEnabled": false,
    "SettlementIntervalHours": 24,
    "SettlementLookbackDays": 3,
    "AutoRefundOnCancellation": true,
    "MaxPageSize": 50
  },
  "Shipping": {
    "Provider": "",
    "ApiKey": "",
    "ApiUser": "",
    "ApiSecret": "",
    "WebhookSecret": "",
    "BaseUrl": "",
    "TimeoutSeconds": 20,
    "MaxWebhookBytes": 262144,
    "WebhookSkewMinutes": 60,
    "VolumetricDivisor": 5000,
    "FreightGstRate": 18,
    "ServiceabilityTtlHours": 24,
    "ServiceabilityRefreshEnabled": false,
    "ServiceabilityRefreshIntervalHours": 24,
    "ServiceabilityRefreshBatchSize": 200,
    "EventProcessorEnabled": false,
    "EventPollIntervalSeconds": 5,
    "EventBatchSize": 25,
    "MaxEventAttempts": 8,
    "EventRetryBackoffSeconds": 30,
    "TrackingPollEnabled": false,
    "TrackingPollIntervalMinutes": 30,
    "TrackingSilenceHours": 24,
    "TrackingPollBatchSize": 50,
    "AutoDraftOnConfirmation": true,
    "AutoSchedulePickup": false,
    "MaxPageSize": 50
  },
  "Returns": {
    "ReturnNumberPrefix": "RMA",
    "ReturnNumberDigits": 6,
    "CreditNoteDigits": 5,
    "SweeperEnabled": false,
    "SweepIntervalMinutes": 60,
    "SweepBatchSize": 100,
    "MaxPageSize": 50
  },
  "Settlements": {
    "PayoutReferencePrefix": "PAY",
    "PayoutReferenceDigits": 6,
    "SchedulerEnabled": false,
    "SchedulerIntervalMinutes": 60,
    "SchedulerBatchSize": 100,
    "ReconciliationEnabled": false,
    "ReconciliationIntervalMinutes": 15,
    "ReconciliationBatchSize": 50,
    "StaleTransferHours": 24,
    "MaxPageSize": 50,
    "MaxExportRows": 10000
  },
  "Search": {
    "Provider": "",
    "BaseUrl": "",
    "ApiKey": "",
    "IndexName": "products",
    "TimeoutSeconds": 5,
    "MaxPageSize": 48,
    "MaxFilterValues": 50,
    "MaxAttributeFilters": 8,
    "VocabularyCacheSeconds": 60,
    "ReindexEnabled": false,
    "ReindexIntervalMinutes": 15,
    "ReindexBatchSize": 200,
    "StaleAfterHours": 24,
    "MaxRebuildVariants": 100000,
    "MaxReportRows": 100
  },
  "Content": {
    "SchedulerEnabled": false,
    "SchedulerIntervalSeconds": 60,
    "SchedulerBatchSize": 50,
    "CollectionRefreshEnabled": false,
    "CollectionRefreshIntervalMinutes": 30,
    "CollectionRefreshBatchSize": 5,
    "CollectionStaleAfterHours": 6,
    "CatalogWalkPageSize": 250,
    "MaxWalkedVariants": 50000,
    "MaxPageSize": 48,
    "MaxCarouselProducts": 24,
    "TrackRedirectHits": true,
    "RobotsCacheSeconds": 900
  },
  "Reviews": {
    "AutoApproveReviews": false,
    "AutoApproveQuestions": false,
    "AutoApproveAnswers": false,
    "AutoApproveVendorAnswers": true,
    "ReviewWindowDays": 365,
    "MaxPageSize": 20,
    "SubscriptionExpiryDays": 90,
    "MaxAlertsPerEvent": 500,
    "SweepEnabled": false,
    "SweepIntervalMinutes": 30,
    "SweepBatchSize": 500,
    "MaxReviewImages": 6,
    "ShareLinkDays": 0
  },
  "Reporting": {
    "CurrencyCode": "INR",
    "MaxReportRows": 5000,
    "MaxPeriodDays": 1100,
    "SnapshotEnabled": false,
    "SnapshotHourUtc": 0,
    "SnapshotCheckIntervalMinutes": 30,
    "SnapshotPageSize": 250,
    "MaxSnapshotLines": 100000,
    "SchedulerEnabled": false,
    "SchedulerIntervalMinutes": 5,
    "SchedulerBatchSize": 5,
    "DownloadLinkMinutes": 15,
    "ExportRetentionDays": 90
  },
  "Payouts": {
    "Provider": "",
    "Mode": "IMPS",
    "Narration": "Marketplace payout",
    "SendBatchSize": 50
  },
  "Razorpay": {
    "KeyId": "",
    "KeySecret": "",
    "WebhookSecret": "",
    "AccountNumber": "",
    "RouteEnabled": false,
    "BaseUrl": "https://api.razorpay.com/v1/",
    "TimeoutSeconds": 20
  },
  "Encryption": {
    "CurrentKeyId": "",
    "Keys": {}
  },
  "AllowedHosts": "*"
}
