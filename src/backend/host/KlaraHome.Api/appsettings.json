{
  "Api": {
    "Version": "v1",
    "EnableApiReference": true,
    "ApiReferencePath": "/scalar",
    "EnableDiagnosticsEndpoints": false,
    "TrustProxyHeaders": true
  },
  "Tenant": {
    "Code": "klarahome",
    "DefaultLocale": "en-IN",
    "DefaultTimeZone": "Asia/Kolkata"
  },
  "Database": {
    "CommandTimeoutSeconds": 30,
    "MaxRetryCount": 3,
    "MaxRetryDelaySeconds": 10,
    "MigrateOnStartup": false,
    "EnableSensitiveDataLogging": false,
    "RunSeeders": true
  },
  "Observability": {
    "ServiceName": "klarahome-api",
    "MinimumLevel": "Information",
    "TraceSampleRatio": 1.0
  },
  "Cors": {
    "AllowedOrigins": [],
    "AllowCredentials": true,
    "PreflightMaxAgeSeconds": 600
  },
  "RateLimiting": {
    "Enabled": true,
    "Global": {
      "PermitLimit": 600,
      "WindowSeconds": 60
    },
    "StorefrontRead": {
      "PermitLimit": 300,
      "WindowSeconds": 60
    },
    "Auth": {
      "PermitLimit": 10,
      "WindowSeconds": 60
    },
    "Otp": {
      "PermitLimit": 20,
      "WindowSeconds": 3600
    },
    "CartWrite": {
      "PermitLimit": 60,
      "WindowSeconds": 60
    },
    "PlaceOrder": {
      "PermitLimit": 5,
      "WindowSeconds": 60
    },
    "AdminWrite": {
      "PermitLimit": 120,
      "WindowSeconds": 60
    }
  },
  "Storage": {
    "Bucket": "media-public",
    "PrivateBucket": "docs-private",
    "Region": "ap-south-1",
    "ForcePathStyle": true,
    "SignedUrlMinutes": 10
  },
  "Media": {
    "MaxImageBytes": 10485760,
    "MaxDocumentBytes": 26214400,
    "MaxImageDimension": 8000,
    "RequireVirusScan": false,
    "VariantWidths": [ 160, 480, 960, 1600 ],
    "Imgproxy": {
      "Format": "webp"
    }
  },
  "Notifications": {
    "DispatcherEnabled": false,
    "PollIntervalSeconds": 5,
    "BatchSize": 25,
    "MaxAttempts": 6,
    "RetryBaseSeconds": 30,
    "RetryMaxSeconds": 3600,
    "DefaultLocale": "en-IN"
  },
  "Email": {
    "Provider": "",
    "FromAddress": "",
    "Smtp": {
      "Port": 587,
      "UseTls": true,
      "TimeoutSeconds": 15
    }
  },
  "Sms": {
    "Provider": ""
  },
  "AllowedHosts": "*"
}
