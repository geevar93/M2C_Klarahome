{
  "Api": {
    "Version": "v1",
    "EnableApiReference": true,
    "ApiReferencePath": "/scalar",
    "EnableDiagnosticsEndpoints": false,
    "TrustProxyHeaders": true
  },
  "Tenant": {
    "Code": "klarahome",
    "DefaultLocale": "en-IN",
    "DefaultTimeZone": "Asia/Kolkata"
  },
  "Observability": {
    "ServiceName": "klarahome-api",
    "MinimumLevel": "Information",
    "TraceSampleRatio": 1.0
  },
  "Cors": {
    "AllowedOrigins": [],
    "AllowCredentials": true,
    "PreflightMaxAgeSeconds": 600
  },
  "RateLimiting": {
    "Enabled": true,
    "Global": { "PermitLimit": 600, "WindowSeconds": 60 },
    "StorefrontRead": { "PermitLimit": 300, "WindowSeconds": 60 },
    "Auth": { "PermitLimit": 10, "WindowSeconds": 60 },
    "Otp": { "PermitLimit": 20, "WindowSeconds": 3600 },
    "CartWrite": { "PermitLimit": 60, "WindowSeconds": 60 },
    "PlaceOrder": { "PermitLimit": 5, "WindowSeconds": 60 },
    "AdminWrite": { "PermitLimit": 120, "WindowSeconds": 60 }
  },
  "AllowedHosts": "*"
}
