<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Catalog (Step 10): the product information model - what this marketplace sells, described once.

    Taxonomy (categories, brands, attributes), the Product -> Variant spine, and the per-vendor
    Listing that turns a variant into something purchasable. It owns *what* a thing is; it does not
    own how many there are (Inventory), what it costs after promotions (Pricing), or who is selling
    it (Vendors) - those modules hold a plain listing_id or vendor_id and ask across a contract.
  -->

  <PropertyGroup>
    <RootNamespace>KlaraHome.Modules.Catalog</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../shared/KlaraHome.SharedKernel/KlaraHome.SharedKernel.csproj" />
    <ProjectReference Include="../../shared/KlaraHome.Contracts/KlaraHome.Contracts.csproj" />
    <ProjectReference Include="../../shared/KlaraHome.Infrastructure/KlaraHome.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Design-time only: `dotnet ef` needs it in the project that holds the migrations. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="KlaraHome.UnitTests" />
    <InternalsVisibleTo Include="KlaraHome.IntegrationTests" />
  </ItemGroup>

</Project>
