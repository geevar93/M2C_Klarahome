<Project>

  <!--
    Central Package Management (CPM).
    Every PackageReference in this solution is versionless; the version is declared HERE, once.

    Convention: a PackageVersion entry is added at the moment a package is first genuinely
    needed by a step, with the version verified against the feed at that time. Versions are
    deliberately NOT pre-populated speculatively — an unverified pin is worse than no pin.

    Licensing guard (docs/01-architecture.md §4.3 / ADR-009): packages that carry a commercial
    licence for commercial use MUST NOT be added.
      * MediatR          -> use the in-house dispatcher in KlaraHome.Infrastructure/Messaging.
      * AutoMapper       -> use Mapperly (source generator) or hand-written mapping.
      * FluentAssertions -> v8+ is commercially licensed by Xceed. NOT USED AT ALL: the tests
                            assert with xUnit's built-in Assert, so no assertion library can
                            ever impose a licence on this product.
                            See docs/adr/ADR-012-no-assertion-library.md.
      * QuestPDF         -> dual-licensed; free only below USD 1M revenue, which is a per-client
                            obligation a redistributed deployment cannot carry.
                            Use PDFsharp + MigraDoc (MIT), pinned below.
                            See docs/adr/ADR-015-pdfsharp-migradoc-for-documents.md.
  -->

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <ItemGroup Label="API / OpenAPI">
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.11" />
    <PackageVersion Include="Scalar.AspNetCore" Version="2.17.3" />
    <!--
      Build-time export of the OpenAPI document. This is what makes the contract a build artefact
      rather than something only a running server can tell you: `dotnet build` writes
      openapi.json beside the host project, and tools/generate-api-client.mjs turns it into the
      Angular client (docs/04-api-specification.md section 7). MIT, by Microsoft.
    -->
    <PackageVersion Include="Microsoft.Extensions.ApiDescription.Server" Version="10.0.11" />
  </ItemGroup>

  <ItemGroup Label="Identity">
    <!--
      JWT bearer validation. Ships out of band from the shared framework but versions in lockstep
      with it, so it tracks the ASP.NET Core 10.0.11 pinned above. MIT, by Microsoft.
    -->
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.11" />
    <!--
      Argon2id password hashing (docs/07-security-compliance.md 1). MIT, pure managed, no native
      dependency. .NET has PBKDF2 built in and no memory-hard KDF at all, and the specification
      names Argon2id rather than a family - a GPU-parallel KDF is exactly what it rules out.
    -->
    <PackageVersion Include="Konscious.Security.Cryptography.Argon2" Version="1.3.1" />
  </ItemGroup>

  <ItemGroup Label="Persistence">
    <!--
      EF Core 10.0.11 tracks the ASP.NET Core 10.0.11 already pinned above; the Npgsql provider
      versions independently (10.0.3) and is PostgreSQL-licensed, so it carries no redistribution
      liability. Previews are excluded by global.json (allowPrerelease: false) — EF Core 11 is
      preview-only at the time of writing and is deliberately not used.
    -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="10.0.11" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.11" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.11" />
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <!--
      snake_case identifiers (docs/03-database-design.md 1). Apache-2.0, by the Npgsql provider's
      own maintainer, and it rewrites every identifier kind - tables, columns, keys, indexes,
      constraints, sequences - which a hand-rolled convention reliably gets wrong for the ones
      nobody remembers to test.
    -->
    <PackageVersion Include="EFCore.NamingConventions" Version="10.0.1" />
  </ItemGroup>

  <ItemGroup Label="Media, storage and documents (Step 8)">
    <!--
      The S3 API client. Apache-2.0, by AWS. MinIO, Cloudflare R2 and S3 itself all speak this
      protocol, which is what makes the move off the VPS a configuration change rather than a
      rewrite (docs/08-integrations.md #4, ADR-010). The `Minio` .NET SDK would have tied us to
      one server implementation for no gain.
    -->
    <PackageVersion Include="AWSSDK.S3" Version="4.0.102.5" />
    <!--
      SMTP. MIT, by the author of the MIME parser the .NET ecosystem standardised on.
      System.Net.Mail.SmtpClient is documented by Microsoft as obsolete for new development and
      does not support the modern authentication and TLS negotiation an email host expects.
    -->
    <PackageVersion Include="MailKit" Version="4.17.0" />
    <!--
      PDF generation. MIT since 6.0 - one package carrying both PDFsharp (the renderer) and
      MigraDoc (the document model: sections, tables with repeating headers, page numbering).
      See ADR-015 for why this and not QuestPDF.
    -->
    <PackageVersion Include="PDFsharp-MigraDoc" Version="6.2.4" />
  </ItemGroup>

  <ItemGroup Label="Validation">
    <PackageVersion Include="FluentValidation" Version="12.1.1" />
    <PackageVersion Include="FluentValidation.DependencyInjectionExtensions" Version="12.1.1" />
  </ItemGroup>

  <ItemGroup Label="Logging">
    <PackageVersion Include="Serilog.AspNetCore" Version="10.0.0" />
    <PackageVersion Include="Serilog.Sinks.Console" Version="6.1.1" />
    <PackageVersion Include="Serilog.Formatting.Compact" Version="3.0.0" />
    <PackageVersion Include="Serilog.Enrichers.Environment" Version="3.0.1" />
  </ItemGroup>

  <ItemGroup Label="Telemetry">
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.18.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.18.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Http" Version="1.18.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Runtime" Version="1.18.0" />
    <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.18.0" />
  </ItemGroup>

  <ItemGroup Label="Health">
    <PackageVersion Include="AspNetCore.HealthChecks.NpgSql" Version="9.0.0" />
    <PackageVersion Include="AspNetCore.HealthChecks.Redis" Version="9.0.0" />
  </ItemGroup>

  <ItemGroup Label="Testing">
    <!-- xUnit v3 is a Microsoft.Testing.Platform runner: no VSTest adapter, no test SDK. -->
    <PackageVersion Include="xunit.v3" Version="4.0.0" />
    <PackageVersion Include="NSubstitute" Version="6.2.0" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.11" />
    <PackageVersion Include="NetArchTest.Rules" Version="1.3.2" />
    <!-- MIT. Spins a throwaway Postgres 18 container so the DB tests run the real provider. -->
    <PackageVersion Include="Testcontainers.PostgreSql" Version="4.14.0" />
  </ItemGroup>

</Project>
