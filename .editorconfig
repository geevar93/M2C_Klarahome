# Klara Home — editor & analyzer conventions
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2
max_line_length = 120

[*.md]
trim_trailing_whitespace = false

[*.{cs,csx}]
indent_size = 4

##########################################
# C# style & analyzer severity
##########################################
[*.cs]
# Usings
csharp_using_directive_placement = outside_namespace:warning
dotnet_sort_system_directives_first = true
dotnet_separate_import_directive_groups = false

# Modern language features
csharp_style_namespace_declarations = file_scoped:error
csharp_style_var_for_built_in_types = false:suggestion
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_prefer_braces = true:warning
csharp_style_prefer_primary_constructors = true:suggestion
csharp_style_expression_bodied_methods = when_on_single_line:suggestion
csharp_style_prefer_pattern_matching = true:suggestion
csharp_style_throw_expression = true:suggestion
dotnet_style_prefer_conditional_expression_over_return = false:suggestion

# Immutability / correctness
dotnet_style_readonly_field = true:warning
# Interface members cannot carry an accessibility modifier idiomatically, so the rule stops at
# the interface boundary (Step 3: `always` also flagged interface members).
dotnet_style_require_accessibility_modifiers = for_non_interface_members:warning
csharp_prefer_static_local_function = true:warning

# Naming: private fields _camelCase.
# Constants and static readonly fields are deliberately NOT covered by this rule (Step 5): the
# .NET convention is PascalCase for both, and the more specific rules below win over it.
dotnet_naming_rule.private_fields_underscore.symbols = private_fields
dotnet_naming_rule.private_fields_underscore.style = underscore_camel
dotnet_naming_rule.private_fields_underscore.severity = warning
dotnet_naming_symbols.private_fields.applicable_kinds = field
dotnet_naming_symbols.private_fields.applicable_accessibilities = private
dotnet_naming_style.underscore_camel.capitalization = camel_case
dotnet_naming_style.underscore_camel.required_prefix = _

# Naming: private constants PascalCase. More specific than private_fields (it requires `const`),
# so it takes precedence over the underscore rule.
dotnet_naming_rule.private_constants_pascal.symbols = private_constants
dotnet_naming_rule.private_constants_pascal.style = pascal
dotnet_naming_rule.private_constants_pascal.severity = warning
dotnet_naming_symbols.private_constants.applicable_kinds = field
dotnet_naming_symbols.private_constants.applicable_accessibilities = private, protected, internal, protected_internal, private_protected
dotnet_naming_symbols.private_constants.required_modifiers = const

# Naming: private static readonly fields PascalCase. They are immutable shared values and read
# as constants at every call site; `_camelCase` implies mutable per-instance state.
dotnet_naming_rule.private_static_readonly_pascal.symbols = private_static_readonly
dotnet_naming_rule.private_static_readonly_pascal.style = pascal
dotnet_naming_rule.private_static_readonly_pascal.severity = warning
dotnet_naming_symbols.private_static_readonly.applicable_kinds = field
dotnet_naming_symbols.private_static_readonly.applicable_accessibilities = private, protected, internal, protected_internal, private_protected
dotnet_naming_symbols.private_static_readonly.required_modifiers = static, readonly

dotnet_naming_style.pascal.capitalization = pascal_case

# Async methods must end in Async
dotnet_naming_rule.async_methods_async_suffix.symbols = async_methods
dotnet_naming_rule.async_methods_async_suffix.style = async_suffix
dotnet_naming_rule.async_methods_async_suffix.severity = warning
dotnet_naming_symbols.async_methods.applicable_kinds = method
dotnet_naming_symbols.async_methods.required_modifiers = async
dotnet_naming_style.async_suffix.capitalization = pascal_case
dotnet_naming_style.async_suffix.required_suffix = Async

##########################################
# Rules that protect decisions in docs/
##########################################
# CA1062 null checks on public args
dotnet_diagnostic.CA1062.severity = suggestion
# Do not use DateTime.Now / UtcNow directly — IClock abstraction (01-architecture.md §6)
dotnet_diagnostic.CA1305.severity = warning
# ConfigureAwait not required in ASP.NET Core
dotnet_diagnostic.CA2007.severity = none
# Prefer string comparison with StringComparison
dotnet_diagnostic.CA1307.severity = warning
# Seal internal types
dotnet_diagnostic.CA1852.severity = warning

[*.{ts,js,mjs,cjs}]
indent_size = 2
quote_type = single

[*.{json,jsonc,yml,yaml}]
indent_size = 2

[*.{html,scss,css}]
indent_size = 2

[*.{sln,csproj,props,targets}]
indent_size = 2
end_of_line = crlf

# -----------------------------------------------------------------------------
# Analyzer severities (Step 3)
# -----------------------------------------------------------------------------
[*.cs]
# CA1716: `Error`, `Result` and friends collide with VB/F# keywords. They are the domain
# vocabulary of the SharedKernel and this codebase is C#-only, so the rule buys nothing.
dotnet_diagnostic.CA1716.severity = none

# -----------------------------------------------------------------------------
# Generated code (Step 4)
# -----------------------------------------------------------------------------
# EF Core migrations are written by `dotnet ef`, not by hand. Holding generated files to the
# hand-written style rules means either editing every migration after generating it, or watching
# CI fail on code nobody typed. The correctness analyzers still apply; only style does not.
[**/Migrations/*.cs]
# `dotnet ef` writes the migration itself with a UTF-8 BOM and the Designer/snapshot without one.
# Neither is configurable, so the charset requirement is lifted here rather than hand-edited back
# after every generation (Step 5 — it is what `dotnet format --verify-no-changes` fails on).
charset = unset
dotnet_diagnostic.IDE0161.severity = none
dotnet_diagnostic.IDE0055.severity = none
dotnet_diagnostic.IDE0300.severity = none
dotnet_diagnostic.IDE0301.severity = none
dotnet_diagnostic.SA1601.severity = none
dotnet_diagnostic.CA1861.severity = none
dotnet_diagnostic.CA1062.severity = none

# -----------------------------------------------------------------------------
# Test projects (Step 5)
# -----------------------------------------------------------------------------
# Test methods are named as sentences — `Probes_are_never_cached` — because that name is what a
# failure report prints. Appending `Async` to the async ones would say nothing about the test and
# split the naming of one suite in two. Production code keeps the rule, exactly as CA1707 is
# relaxed here (Directory.Build.props) and enforced everywhere else.
[src/backend/tests/**/*.cs]
dotnet_naming_rule.async_methods_async_suffix.severity = none
